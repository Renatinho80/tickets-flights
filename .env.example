# =============================================================================
# Flight Analyst — Arquivo de Exemplo (.env.example)
# Copie este arquivo para .env e preencha com suas chaves reais.
# =============================================================================

# --- Supabase (Banco de Dados) ---
SUPABASE_URL=https://sua-url.supabase.co
SUPABASE_KEY=sua-chave-anon-publica

# --- SerpApi (Fallback de scraping - Opcional) ---
SERPAPI_KEY=sua-chave-aqui

# --- Amadeus (Dados Históricos e Aeroportos) ---
AMADEUS_CLIENT_ID=seu-client-id
AMADEUS_CLIENT_SECRET=seu-client-secret
# Opções: test | production
AMADEUS_ENV=test

# --- Google Gemini (Motor de Inteligência) ---
GOOGLE_API_KEY=sua-chave-google-aqui

# --- Telegram Bot (Notificações) ---
TELEGRAM_BOT_TOKEN=seu-token-bot
# Envie /start para @userinfobot no Telegram para descobrir seu ID
TELEGRAM_CHAT_ID=seu-chat-id-numerico

# --- Inngest (Agendador Cloud - Opcional) ---
INNGEST_EVENT_KEY=sua-event-key
INNGEST_SIGNING_KEY=sua-signing-key

# --- Sentry (Monitoramento de Erros - Opcional) ---
SENTRY_DSN=sua-dsn-aqui

# --- Ntfy (Fallback de Notificação - Opcional) ---
NTFY_TOPIC=seu-topico-customizado

# --- Segurança da Aplicação ---
# Chave para autenticação nos endpoints da API FastAPI
APP_API_KEY=gerar-uma-senha-segura-aqui
# Senha para acessar a interface do Streamlit
DASHBOARD_PASSWORD=sua-senha-do-painel-aqui

# --- Configurações de Ambiente ---
# development | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Porta para o servidor FastAPI
API_PORT=8000
# Caminho para o banco SQLite local (usado apenas se o Supabase estiver off em dev)
SQLITE_PATH=./data/flight_analyst.db
